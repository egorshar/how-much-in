{
  "cli": {
    "version": ">= 3.13.2",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "node": "22.11.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "node": "22.11.0",
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "node": "22.11.0",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6459408194"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}